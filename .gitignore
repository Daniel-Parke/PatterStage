# See https://help.github.com/articles/ignoring-files/

# Dependencies
node_modules/
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions
__pycache__/

# Testing
coverage/
**/coverage/
coverage-report/
playwright-report/
test-results/

# Next.js
.next/
**/.next/
.swc/
out/
build/

# Runtime data (CH_DATA_DIR mirror under repo root; not in repo)
/data/*
!/data/seed/
!/data/seed/**

# Environment
.env
.env.local
.env*.local

# OS
.DS_Store
*.pem

# Debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
pnpm-lock.yaml
pnpm-workspace.yaml
a.out
.npmrc
!/.npmrc

# Vercel
.vercel

# TypeScript
*.tsbuildinfo
next-env.d.ts

# The documentation pipeline's two outputs (B15, decision 3). Both are built
# from docs/**/*.md by scripts/docs/build-site.mjs: site/ is what GitHub Pages
# publishes, public/help/ is what the in-app Help section reads and is rebuilt
# by `prebuild` before every `next build`. docs/manifest.json IS committed —
# it is the derived view check-derived-views.mjs holds against the front matter.
/site/
/public/help/

# Build artifacts
a.out
pnpm-lock.yaml
pnpm-workspace.yaml
!/.npmrc

# Session-scoped audit artifacts (pre-merge dogfood reports, server stdout from local runs)
dogfood-output/
runtime.log
*.audit.md

# Hermes Agent scratch written into the project root during LLM sessions.
# Real Hermes state lives under ~/.hermes/; nothing inside any project repo
# should be tracked. /workspace/.hermes/ is the upstream agent's own
# scratch-root convention and is the same shape we see leak in here.
.hermes/
/.hermes

# real-Hermes test harness runtime artifacts
test-harness/.work/

# Playwright isolated E2E data dir
tmp/

# Agent/editor session config. .claude/launch.json was committed by accident in
# 32bb881 (a `git add -A` sweep); it is a local dev-server preview config, not
# project state. Kept on disk, out of the repo.
.claude/
