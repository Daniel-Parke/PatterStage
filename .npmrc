packageManager=pnpm@10.33.0
approve-builds=true
# shamefully-hoist=true: hoist packages to top-level node_modules so bare
# specifiers (e.g. test code importing "jest-mock") resolve consistently.
# The repo carries stale top-level node_modules/jest-*@30.3.0 dirs from a
# previous npm install — those were missing jest-mock's clearMocksOnScope
# (added in 30.4.0+) and caused 158/329 suites to fail with
# "clearMocksOnScope is not a function". A flat node_modules layout
# (equivalent to npm's behaviour) makes resolution pick up the pnpm-store
# version instead of the stale dir. This .npmrc is tracked in git so all
# developers + CI get the same resolution.
shamefully-hoist=true