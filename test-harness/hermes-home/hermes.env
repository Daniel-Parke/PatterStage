# Real-Hermes integration-test fixture secrets/flags. Test-only values.
# Named `hermes.env` (not `.env`) so it survives .gitignore/.dockerignore;
# the seed image copies it to /opt/data/.env inside the Hermes volume.
API_SERVER_ENABLED=true
API_SERVER_KEY=hermes-real-itest-key
API_SERVER_HOST=0.0.0.0
API_SERVER_PORT=8642
# Dummy key for the custom (mock) LLM provider — never validated against a local server.
CUSTOM_API_KEY=dummy
OPENAI_API_KEY=dummy
