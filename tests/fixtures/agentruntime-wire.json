{
  "description": "The AgentRuntime <-> Hermes 0.16 wire contract, as recorded shapes (ADR 0011, Phase 3). The TypeScript implementation (PatterStage src/lib/runtime/HermesRuntime.ts, verified against real Hermes 0.16) is the reference; the Python implementation (pattertech.agents.runtime.hermes) must match it case-for-case. Run in BOTH repos' CIs: tests/test_agentruntime_wire.py here; a mirror test consumes this same file in PatterStage. Expected values use wire-style snake_case; the TS side maps to its camelCase DTOs.",
  "status_normalisation": [
    { "wire": "completed", "expect": "completed" },
    { "wire": "succeeded", "expect": "completed" },
    { "wire": "success", "expect": "completed" },
    { "wire": "COMPLETED", "expect": "completed" },
    { "wire": "failed", "expect": "failed" },
    { "wire": "error", "expect": "failed" },
    { "wire": "cancelled", "expect": "cancelled" },
    { "wire": "canceled", "expect": "cancelled" },
    { "wire": "stopped", "expect": "cancelled" },
    { "wire": "started", "expect": "started" },
    { "wire": "running", "expect": "started" },
    { "wire": "in_progress", "expect": "started" },
    { "wire": "queued", "expect": "started" },
    { "wire": "pending", "expect": "started" },
    { "wire": "done", "expect": "started", "note": "NOT in the verified 0.16 vocabulary - unknowns fall through to started on both sides" },
    { "wire": "finished", "expect": "started" },
    { "wire": "errored", "expect": "started" },
    { "wire": "aborted", "expect": "started" },
    { "wire": "", "expect": "started" },
    { "wire": null, "expect": "started" }
  ],
  "usage_mapping": [
    { "wire": { "input_tokens": 120, "output_tokens": 45, "total_tokens": 165 },
      "expect": { "input_tokens": 120, "output_tokens": 45, "total_tokens": 165 } },
    { "wire": { "prompt_tokens": 10, "completion_tokens": 5 },
      "expect": { "input_tokens": 10, "output_tokens": 5, "total_tokens": 15 },
      "note": "OpenAI-style aliases; total derived when absent" },
    { "wire": { "input_tokens": 7 },
      "expect": { "input_tokens": 7, "output_tokens": 0, "total_tokens": 7 } },
    { "wire": null, "expect": null },
    { "wire": "not-an-object", "expect": null }
  ],
  "run_result_mapping": [
    { "name": "full result",
      "run_id_param": "r-1",
      "wire": { "run_id": "r-1", "status": "completed", "session_id": "s-9",
                "output": "the answer", "usage": { "input_tokens": 3, "output_tokens": 4 },
                "error": null },
      "expect": { "run_id": "r-1", "status": "completed", "session_id": "s-9",
                  "output": "the answer",
                  "usage": { "input_tokens": 3, "output_tokens": 4, "total_tokens": 7 },
                  "error": null } },
    { "name": "run_id falls back to the requested id",
      "run_id_param": "r-2",
      "wire": { "status": "running" },
      "expect": { "run_id": "r-2", "status": "started", "session_id": null,
                  "output": null, "usage": null, "error": null } },
    { "name": "non-string output/error are dropped, failure surfaces",
      "run_id_param": "r-3",
      "wire": { "run_id": "r-3", "status": "failed", "output": { "not": "a string" },
                "error": "boom" },
      "expect": { "run_id": "r-3", "status": "failed", "session_id": null,
                  "output": null, "usage": null, "error": "boom" } }
  ],
  "submit_mapping": [
    { "name": "run_id preferred over id",
      "wire": { "run_id": "r-10", "id": "ignored", "status": "queued" },
      "expect": { "run_id": "r-10", "status": "started" } },
    { "name": "id accepted when run_id absent",
      "wire": { "id": "r-11", "status": "in_progress", "session_id": "s-2" },
      "expect": { "run_id": "r-11", "status": "started", "session_id": "s-2" } }
  ],
  "sse_events": [
    { "name": "event field wins",
      "block": "event: run.completed\ndata: {\"event\": \"something-else\", \"ok\": true}",
      "expect": { "type": "run.completed" } },
    { "name": "data.event when no SSE event field (real Hermes 0.16 emits data-only lines)",
      "block": "data: {\"event\": \"message.delta\", \"delta\": \"hel\"}",
      "expect": { "type": "message.delta" } },
    { "name": "data.type as the next fallback",
      "block": "data: {\"type\": \"reasoning.available\"}",
      "expect": { "type": "reasoning.available" } },
    { "name": "non-JSON data stays a raw string, type defaults to message",
      "block": "data: plain text chunk",
      "expect": { "type": "message", "data": "plain text chunk" } },
    { "name": "multi data lines join with newlines",
      "block": "data: {\"event\":\ndata: \"run.completed\"}",
      "expect": { "type": "run.completed" } },
    { "name": "empty block parses to nothing",
      "block": "\n",
      "expect": null },
    { "name": "comment-only block parses to nothing",
      "block": ": keepalive",
      "expect": null }
  ]
}
